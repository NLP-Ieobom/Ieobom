{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Ieobom syllabus extraction",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "syllabus_id",
    "verification_status",
    "sources",
    "course",
    "term",
    "overview",
    "learning_objectives",
    "weekly_topics",
    "concepts",
    "official_prerequisites",
    "suggested_connections"
  ],
  "properties": {
    "schema_version": {
      "const": "1.0"
    },
    "syllabus_id": {
      "type": "string",
      "minLength": 1
    },
    "verification_status": {
      "enum": [
        "needs_review",
        "verified"
      ]
    },
    "sources": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/source"
      },
      "minItems": 1
    },
    "course": {
      "$ref": "#/$defs/course"
    },
    "term": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "academic_year",
        "semester",
        "section"
      ],
      "properties": {
        "academic_year": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 1900
        },
        "semester": {
          "enum": [
            "spring",
            "fall",
            "summer",
            "winter",
            null
          ]
        },
        "section": {
          "type": [
            "string",
            "null"
          ],
          "minLength": 1
        }
      }
    },
    "overview": {
      "anyOf": [
        {
          "$ref": "#/$defs/sourced_text"
        },
        {
          "type": "null"
        }
      ]
    },
    "learning_objectives": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/sourced_text"
      }
    },
    "weekly_topics": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/week"
      }
    },
    "concepts": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/concept"
      }
    },
    "official_prerequisites": {
      "anyOf": [
        {
          "type": "array",
          "items": {
            "$ref": "#/$defs/prerequisite"
          }
        },
        {
          "type": "null"
        }
      ]
    },
    "suggested_connections": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/connection"
      }
    }
  },
  "$defs": {
    "source": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "source_id",
        "role",
        "title",
        "kind"
      ],
      "properties": {
        "source_id": {
          "type": "string",
          "minLength": 1
        },
        "role": {
          "enum": [
            "syllabus",
            "curriculum"
          ]
        },
        "title": {
          "type": "string",
          "minLength": 1
        },
        "kind": {
          "enum": [
            "pdf",
            "web"
          ]
        },
        "document_id": {
          "type": "string",
          "minLength": 1
        },
        "url": {
          "type": "string",
          "format": "uri",
          "pattern": "^https?://"
        }
      },
      "if": {
        "properties": {
          "kind": {
            "const": "pdf"
          }
        }
      },
      "then": {
        "required": [
          "document_id"
        ]
      },
      "else": {
        "required": [
          "url"
        ],
        "not": {
          "required": [
            "document_id"
          ]
        }
      }
    },
    "course": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "course_id",
        "course_code",
        "name",
        "curriculum_year",
        "aliases",
        "evidence"
      ],
      "properties": {
        "course_id": {
          "type": "string",
          "minLength": 1
        },
        "course_code": {
          "type": [
            "string",
            "null"
          ],
          "minLength": 1
        },
        "name": {
          "type": "string",
          "minLength": 1
        },
        "curriculum_year": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 1900
        },
        "aliases": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/alias"
          }
        },
        "evidence": {
          "$ref": "#/$defs/evidence_list"
        }
      }
    },
    "alias": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "name",
        "course_code",
        "evidence"
      ],
      "properties": {
        "name": {
          "type": "string",
          "minLength": 1
        },
        "course_code": {
          "type": [
            "string",
            "null"
          ],
          "minLength": 1
        },
        "evidence": {
          "$ref": "#/$defs/evidence_list"
        }
      }
    },
    "evidence_list": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/evidence"
      },
      "minItems": 1
    },
    "evidence": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "source_id"
      ],
      "properties": {
        "source_id": {
          "type": "string",
          "minLength": 1
        },
        "page_number": {
          "type": "integer",
          "minimum": 1
        },
        "block_id": {
          "type": "string",
          "minLength": 1
        },
        "section": {
          "type": "string",
          "minLength": 1
        },
        "quote": {
          "type": "string",
          "minLength": 1
        }
      },
      "anyOf": [
        {
          "required": [
            "page_number"
          ]
        },
        {
          "required": [
            "section"
          ]
        },
        {
          "required": [
            "quote"
          ]
        }
      ],
      "dependentRequired": {
        "block_id": [
          "page_number"
        ]
      }
    },
    "sourced_text": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "text",
        "evidence"
      ],
      "properties": {
        "text": {
          "type": "string",
          "minLength": 1
        },
        "evidence": {
          "$ref": "#/$defs/evidence_list"
        }
      }
    },
    "week": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "week",
        "topics"
      ],
      "properties": {
        "week": {
          "type": "integer",
          "minimum": 1
        },
        "topics": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/sourced_text"
          },
          "minItems": 1
        }
      }
    },
    "concept": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "name",
        "weeks",
        "evidence"
      ],
      "properties": {
        "name": {
          "type": "string",
          "minLength": 1
        },
        "weeks": {
          "type": "array",
          "items": {
            "type": "integer",
            "minimum": 1
          },
          "uniqueItems": true
        },
        "evidence": {
          "$ref": "#/$defs/evidence_list"
        }
      }
    },
    "prerequisite": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "course_id",
        "course_name",
        "evidence"
      ],
      "properties": {
        "course_id": {
          "type": [
            "string",
            "null"
          ],
          "minLength": 1
        },
        "course_name": {
          "type": "string",
          "minLength": 1
        },
        "evidence": {
          "$ref": "#/$defs/evidence_list"
        }
      }
    },
    "connection": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "course_id",
        "course_name",
        "reason",
        "evidence"
      ],
      "properties": {
        "course_id": {
          "type": "string",
          "minLength": 1
        },
        "course_name": {
          "type": "string",
          "minLength": 1
        },
        "reason": {
          "type": "string",
          "minLength": 1
        },
        "evidence": {
          "$ref": "#/$defs/evidence_list"
        }
      }
    }
  }
}
