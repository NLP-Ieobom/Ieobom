# ======================================================================
# 이어봄 환경 변수 예시
#   cp .env.example .env  후 값을 채운다. .env 는 커밋하지 않는다.
# ======================================================================

# ---------- 공통 ----------
APP_ENV=local                 # local | dev | prod
LOG_LEVEL=INFO

# ---------- 백엔드 (FastAPI) ----------
API_HOST=0.0.0.0
API_PORT=8000
# Vercel 프론트 도메인을 포함시킨다. 쉼표 구분.
CORS_ALLOW_ORIGINS=http://localhost:5173

# ---------- 인증 ----------
# openssl rand -hex 32 등으로 생성
JWT_SECRET_KEY=change-me
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=14

# ---------- PostgreSQL (+ pgvector) ----------
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=ieobom
POSTGRES_USER=ieobom
POSTGRES_PASSWORD=change-me
# SQLAlchemy 연결 문자열 (위 값으로 조합해도 되고 직접 지정해도 된다)
DATABASE_URL=postgresql+psycopg://ieobom:change-me@localhost:5432/ieobom

# ---------- AWS S3 (비공개 버킷) ----------
AWS_REGION=ap-northeast-2
S3_BUCKET_NAME=ieobom-materials
# EC2에서는 IAM Role 사용을 권장하며, 로컬에서만 키를 쓴다.
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
# presigned URL 유효 시간(초)
S3_PRESIGNED_PUT_EXPIRE=900
S3_PRESIGNED_GET_EXPIRE=3600
# 업로드 허용 최대 크기(bytes). 기본 50MB
MAX_UPLOAD_SIZE=52428800

# ---------- Gemini API ----------
GEMINI_API_KEY=
GEMINI_TEXT_MODEL=gemini-2.5-flash
GEMINI_EMBEDDING_MODEL=gemini-embedding-001
# pgvector 인덱스 제한(2000차원) 때문에 출력 차원을 축소해 사용한다.
GEMINI_EMBEDDING_DIM=1536

# ---------- Semantic Scholar API ----------
# 미발급 시 비워 두면 비인증 레이트리밋(낮음)이 적용된다.
SEMANTIC_SCHOLAR_API_KEY=
SEMANTIC_SCHOLAR_TIMEOUT=20

# ---------- 분석 Worker ----------
WORKER_POLL_INTERVAL_SEC=3      # 잡 큐 폴링 주기
WORKER_CONCURRENCY=1            # Docling 메모리 사용량 때문에 기본 1
WORKER_MAX_ATTEMPTS=3           # 실패 시 재시도 횟수
WORKER_LOCK_TIMEOUT_SEC=900     # 이 시간을 넘긴 잡은 죽은 것으로 보고 회수
WORKER_ID=worker-1
# docker.sock으로 docling 컨테이너를 실행할 때 필요한 절대경로. compose가 올라가는 host 기준 경로.
DOCLING_HOST_DIR=/absolute/path/to/ieobom/docling

# ---------- 프론트엔드 (Vite) ----------
# frontend/.env 로 분리해도 된다. VITE_ 접두사만 브라우저에 노출된다.
VITE_API_BASE_URL=http://localhost:8000/api/v1
