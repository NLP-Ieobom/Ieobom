FROM python:3.12-slim-bookworm

ENV PYTHONUNBUFFERED=1 \
    PYTHONDONTWRITEBYTECODE=1

RUN apt-get update \
    && apt-get install -y --no-install-recommends \
       ca-certificates libglib2.0-0 libgomp1 libgl1 libatomic1 \
    && rm -rf /var/lib/apt/lists/*

RUN python -m pip install --no-cache-dir uv

WORKDIR /app
COPY requirements-docling.txt ./
RUN uv pip install --system --no-cache --torch-backend=cpu \
    -r requirements-docling.txt

COPY docling_check.py ./
ENTRYPOINT ["python", "/app/docling_check.py"]
CMD ["--help"]
