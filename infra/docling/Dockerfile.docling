ARG BACKEND_IMAGE=ieobom-backend:local
FROM ${BACKEND_IMAGE} AS backend

FROM python:3.12-slim-bookworm

ENV PYTHONUNBUFFERED=1 \
    PYTHONDONTWRITEBYTECODE=1 \
    OMP_NUM_THREADS=1 \
    MKL_NUM_THREADS=1 \
    OPENBLAS_NUM_THREADS=1 \
    EASYOCR_MODULE_PATH=/root/.cache/easyocr

RUN apt-get update \
    && apt-get install -y --no-install-recommends \
       ca-certificates libglib2.0-0 libgomp1 libgl1 libatomic1 \
    && rm -rf /var/lib/apt/lists/*

RUN python -m pip install --no-cache-dir uv

WORKDIR /app
COPY requirements-docling.txt ./
RUN uv pip install --system --no-cache --torch-backend=cpu \
    -r requirements-docling.txt

COPY docling_check.py ./
# 워커 이미지에서 추출 코드를 가져와 로컬 CLI와 같은 JSON 형식을 사용한다.
COPY --from=backend /app/app/pipelines/ ./app/pipelines/
ENTRYPOINT ["python", "-m", "app.pipelines.pdf_extraction"]
CMD ["--help"]
