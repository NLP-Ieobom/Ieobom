# ---------- 로컬 데이터 ----------
# 강의자료 PDF 원본과 분석 산출물은 S3에만 둔다.
/data/
/tmp/
*.pdf
!docs/**/*.pdf

# ---------- 명령줄 생성기가 교육과정 ZIP 옆에 저장하는 과목 벡터 캐시 ----------
*.vectors.json

# ---------- Docling 기본 셋업 확인용 입출력 ----------
infra/docling/input/*
!infra/docling/input/.gitkeep
infra/docling/output/*
!infra/docling/output/.gitkeep
